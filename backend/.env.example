NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres — set to your local or cloud instance
# Example local: postgresql://delivery:delivery@localhost:5432/delivery?schema=public
# Pooled URL (runtime) — Neon pooled connection
DATABASE_URL=postgresql://delivery:delivery@localhost:5432/delivery?schema=public
# Direct URL (migrations / db push) — Neon direct connection
DIRECT_URL=postgresql://delivery:delivery@localhost:5432/delivery

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_32_BYTE_HEX
JWT_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

# CORS: * for dev, or comma-separated origins
CORS_ORIGIN=*
LOG_LEVEL=info

