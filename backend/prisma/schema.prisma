generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
  STORE_OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrderType {
  SHOPPING
  COURIER
}

enum OrderStatus {
  PENDING
  QUOTED
  CONFIRMED
  ASSIGNED
  ACCEPTED
  ARRIVING_AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  COLLECTED
  REMITTED
  REFUNDED
  FAILED
}

enum PackageSize {
  ENVELOPE
  SMALL
  MEDIUM
  LARGE
  CUSTOM
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
  TRUCK
  BICYCLE
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
  FAILED
}

enum CheckoutStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  fullName     String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  language     String     @default("ar")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  customer           Customer?
  driver             Driver?
  ownedStores        Store[]         @relation("StoreOwner")
  addresses          Address[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  shoppingOrders     ShoppingOrder[] @relation("ShoppingCustomer")
  courierOrdersSent  CourierOrder[]  @relation("CourierCustomer")
  checkoutGroups     CheckoutGroup[] @relation("CheckoutCustomer")
  deliveryEvents     DeliveryEvent[] @relation("EventActor")

  @@index([role, status])
}

model Customer {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddressId String?  @unique
  defaultAddress   Address? @relation("CustomerDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  carts Cart[]
}

model Driver {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType    VehicleType
  vehiclePlate   String?
  licenseNumber  String?
  isAvailable    Boolean     @default(false)
  isVerified     Boolean     @default(false)
  rating         Float?
  currentLat     Float?
  currentLng     Float?
  lastLocationAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  assignments    Assignment[]
  deliveryEvents DeliveryEvent[]
  proofs         ProofOfDelivery[]
  cashCollected  CashPayment[]

  @@index([isAvailable, isVerified])
}

model Store {
  id             String   @id @default(uuid())
  ownerId        String?
  owner          User?    @relation("StoreOwner", fields: [ownerId], references: [id])
  nameAr         String
  nameEn         String?
  slug           String   @unique
  description    String?
  logoUrl        String?
  phone          String?
  addressText    String
  lat            Float
  lng            Float
  isActive       Boolean  @default(true)
  isOpen         Boolean  @default(true)
  openingHours   Json?
  commissionRate Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories     Category[]
  products       Product[]
  carts          Cart[]
  shoppingOrders ShoppingOrder[]

  @@index([isActive, isOpen])
}

model Category {
  id        String     @id @default(uuid())
  storeId   String?
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  nameAr    String
  nameEn    String?
  slug      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]

  @@unique([storeId, slug])
  @@index([parentId])
}

model Product {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  nameAr         String
  nameEn         String?
  description    String?
  sku            String?
  price          Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  currency       String    @default("SDG")
  imageUrl       String?
  isAvailable    Boolean   @default(true)
  stock          Int?
  weightGrams    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, sku])
  @@index([storeId, isAvailable])
  @@index([categoryId])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  addressText String
  city        String?
  district    String?
  lat         Float?
  lng         Float?
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shoppingOrders     ShoppingOrder[]
  defaultForCustomer Customer?       @relation("CustomerDefaultAddress")

  @@index([userId])
}

model DeliveryZone {
  id        String   @id @default(uuid())
  nameAr    String
  nameEn    String?
  city      String?
  isActive  Boolean  @default(true)
  centerLat Float?
  centerLng Float?
  radiusKm  Float?
  boundary  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules   PricingRule[]
  shoppingOrders ShoppingOrder[]
  courierOrders  CourierOrder[]

  @@index([isActive])
}

model PricingRule {
  id                   String        @id @default(uuid())
  zoneId               String?
  zone                 DeliveryZone? @relation(fields: [zoneId], references: [id])
  orderType            OrderType
  basePrice            Decimal       @db.Decimal(12, 2)
  perKmPrice           Decimal?      @db.Decimal(12, 2)
  minPrice             Decimal?      @db.Decimal(12, 2)
  maxPrice             Decimal?      @db.Decimal(12, 2)
  weightSurchargePerKg Decimal?      @db.Decimal(12, 2)
  priority             Int           @default(0)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([orderType, isActive])
}

model Cart {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]

  @@unique([customerId, storeId])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model CheckoutGroup {
  id          String         @id @default(uuid())
  customerId  String
  customer    User           @relation("CheckoutCustomer", fields: [customerId], references: [id])
  status      CheckoutStatus @default(PENDING)
  totalAmount Decimal        @db.Decimal(12, 2)
  currency    String         @default("SDG")
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  shoppingOrders ShoppingOrder[]

  @@index([customerId, status])
}

model ShoppingOrder {
  id              String         @id @default(uuid())
  orderNumber     String         @unique
  customerId      String
  customer        User           @relation("ShoppingCustomer", fields: [customerId], references: [id])
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  addressId       String
  address         Address        @relation(fields: [addressId], references: [id])
  zoneId          String?
  zone            DeliveryZone?  @relation(fields: [zoneId], references: [id])
  checkoutGroupId String?
  checkoutGroup   CheckoutGroup? @relation(fields: [checkoutGroupId], references: [id], onDelete: SetNull)
  status          OrderStatus    @default(PENDING)
  subtotal        Decimal        @db.Decimal(12, 2)
  deliveryFee     Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  currency        String         @default("SDG")
  paymentMethod   PaymentMethod  @default(CASH_ON_DELIVERY)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?
  cancelledAt     DateTime?

  items       OrderItem[]
  events      DeliveryEvent[]
  assignments Assignment[]
  cashPayment CashPayment?
  proof       ProofOfDelivery?

  @@index([customerId, status])
  @@index([storeId, status])
  @@index([checkoutGroupId])
}

model CourierOrder {
  id                     String        @id @default(uuid())
  orderNumber            String        @unique
  customerId             String
  customer               User          @relation("CourierCustomer", fields: [customerId], references: [id])
  senderName             String
  senderPhone            String
  recipientName          String
  recipientPhone         String
  packageDescription     String
  packageCategory        String
  packageSize            PackageSize
  weightGrams            Int?
  pickupAddressText      String
  pickupLat              Float?
  pickupLng              Float?
  pickupNotes            String?
  destinationAddressText String
  destinationLat         Float?
  destinationLng         Float?
  destinationNotes       String?
  deliveryInstructions   String?
  specialHandlingNotes   String?
  zoneId                 String?
  zone                   DeliveryZone? @relation(fields: [zoneId], references: [id])
  status                 OrderStatus   @default(PENDING)
  quotedPrice            Decimal?      @db.Decimal(12, 2)
  finalPrice             Decimal?      @db.Decimal(12, 2)
  currency               String        @default("SDG")
  paymentMethod          PaymentMethod @default(CASH_ON_DELIVERY)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  completedAt            DateTime?
  cancelledAt            DateTime?

  events      DeliveryEvent[]
  assignments Assignment[]
  cashPayment CashPayment?
  proof       ProofOfDelivery?

  @@index([customerId, status])
}

model OrderItem {
  id              String        @id @default(uuid())
  shoppingOrderId String
  shoppingOrder   ShoppingOrder @relation(fields: [shoppingOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())

  @@index([shoppingOrderId])
}

model Assignment {
  id              String           @id @default(uuid())
  orderType       OrderType
  shoppingOrderId String?
  shoppingOrder   ShoppingOrder?   @relation(fields: [shoppingOrderId], references: [id], onDelete: Cascade)
  courierOrderId  String?
  courierOrder    CourierOrder?    @relation(fields: [courierOrderId], references: [id], onDelete: Cascade)
  driverId        String
  driver          Driver           @relation(fields: [driverId], references: [id])
  status          AssignmentStatus @default(ASSIGNED)
  isActive        Boolean          @default(true)
  assignedAt      DateTime         @default(now())
  respondedAt     DateTime?
  acceptedAt      DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([shoppingOrderId, isActive])
  @@index([courierOrderId, isActive])
  @@index([driverId, status])
}

model DeliveryEvent {
  id              String         @id @default(uuid())
  orderType       OrderType
  shoppingOrderId String?
  shoppingOrder   ShoppingOrder? @relation(fields: [shoppingOrderId], references: [id], onDelete: Cascade)
  courierOrderId  String?
  courierOrder    CourierOrder?  @relation(fields: [courierOrderId], references: [id], onDelete: Cascade)
  status          OrderStatus
  note            String?
  actorId         String?
  actor           User?          @relation("EventActor", fields: [actorId], references: [id])
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id])
  lat             Float?
  lng             Float?
  createdAt       DateTime       @default(now())

  @@index([shoppingOrderId, createdAt])
  @@index([courierOrderId, createdAt])
}

model ProofOfDelivery {
  id              String         @id @default(uuid())
  orderType       OrderType
  shoppingOrderId String?        @unique
  shoppingOrder   ShoppingOrder? @relation(fields: [shoppingOrderId], references: [id], onDelete: Cascade)
  courierOrderId  String?        @unique
  courierOrder    CourierOrder?  @relation(fields: [courierOrderId], references: [id], onDelete: Cascade)
  photoUrl        String?
  signatureUrl    String?
  recipientName   String?
  receivedAt      DateTime       @default(now())
  driverId        String
  driver          Driver         @relation(fields: [driverId], references: [id])
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([driverId])
}

model CashPayment {
  id              String         @id @default(uuid())
  orderType       OrderType
  shoppingOrderId String?        @unique
  shoppingOrder   ShoppingOrder? @relation(fields: [shoppingOrderId], references: [id])
  courierOrderId  String?        @unique
  courierOrder    CourierOrder?  @relation(fields: [courierOrderId], references: [id])
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("SDG")
  status          PaymentStatus  @default(PENDING)
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id])
  collectedAt     DateTime?
  remittedAt      DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleAr   String
  titleEn   String?
  bodyAr    String
  bodyEn    String?
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

